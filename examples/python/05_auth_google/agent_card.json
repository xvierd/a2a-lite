{
  "name": "SecureAgent",
  "description": "A secure agent requiring API Key or Bearer token authentication",
  "supportedInterfaces": [
    {
      "url": "http://localhost:8790/",
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0"
    }
  ],
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false
  },
  "defaultInputModes": ["text/plain"],
  "defaultOutputModes": ["text/plain"],
  "skills": [
    {
      "id": "get_secret",
      "name": "get_secret",
      "description": "Get secret data (requires authentication)",
      "tags": ["secure", "secret"]
    },
    {
      "id": "get_user_info",
      "name": "get_user_info",
      "description": "Get current user authentication info",
      "tags": ["auth", "user"]
    },
    {
      "id": "admin_only",
      "name": "admin_only",
      "description": "Admin-only operation (requires admin permission)",
      "tags": ["admin", "restricted"]
    },
    {
      "id": "public_info",
      "name": "public_info",
      "description": "Public agent information (no auth required)",
      "tags": ["public"]
    }
  ],
  "securitySchemes": {
    "apiKeyAuth": {
      "apiKeySecurityScheme": {
        "description": "API Key authentication via X-API-Key header",
        "location": "header",
        "name": "X-API-Key"
      }
    },
    "bearerAuth": {
      "httpAuthSecurityScheme": {
        "description": "Bearer token authentication",
        "scheme": "bearer"
      }
    }
  },
  "securityRequirements": [
    {"schemes": {"apiKeyAuth": {}}},
    {"schemes": {"bearerAuth": {}}}
  ]
}
