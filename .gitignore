# Build artifacts
node_modules/
dist/
build/
target/
# Eclipse/Gradle IDE output under packages (not source)
packages/**/bin/
*.pyc
__pycache__/
.gradle/
*.class
*.jar
# Gradle needs the wrapper jar in the repo for CI
!**/gradle/wrapper/gradle-wrapper.jar
*.egg-info/
.eggs/
*.whl

# Test / coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
*.lcov

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Python virtual environments
venv/
.venv/
.env
.env.*
!.env.example

# Local tooling / agent worktrees (never commit)
.claude/
.flow/
**/~/**/
**/.flow/
flow.db
**/flow.db

# Accidental home-under-repo dumps
~/

# Lock files — keep TypeScript package-lock for reproducible CI (prettier/eslint)
# Root-level and other package-lock.json files stay ignored.
/package-lock.json
uv.lock
!packages/typescript/package-lock.json
