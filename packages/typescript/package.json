{
  "name": "a2a-lite",
  "version": "1.2.1",
  "description": "Build A2A agents in 8 lines. Add enterprise features when you need them.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "a2a-lite": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "typecheck": "tsc --noEmit",
    "example:hello": "npx tsx examples/01-hello-world.ts"
  },
  "keywords": [
    "a2a",
    "agent",
    "agent-to-agent",
    "ai",
    "llm",
    "sdk"
  ],
  "author": "A2A Lite Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xvierd/a2a-lite.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://github.com/xvierd/a2a-lite/tree/main/packages/typescript",
  "bugs": {
    "url": "https://github.com/xvierd/a2a-lite/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "ipaddr.js": "^2.5.0",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "@aws-sdk/client-bedrock-runtime": ">=3.0.0",
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "express": "^4.21.2 || ^5.1.0",
    "jose": ">=5.0.0",
    "kysely": "^0.28.17 || ^0.29.0",
    "openai": ">=4.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": false
    },
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "jose": {
      "optional": true
    },
    "kysely": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "express": "^5.3.0",
    "kysely": "^0.28.17",
    "pg": "^8.23.1",
    "prettier": "^3.8.1",
    "supertest": "^7.3.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "brace-expansion@^1.1.0": "1.1.21",
    "brace-expansion@^5.0.0": "5.0.12",
    "form-data": "4.0.6",
    "path-to-regexp": "8.4.0",
    "rollup": "4.59.0"
  }
}
